---
interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Software Wizard" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=MedievalSharp&display=swap" rel="stylesheet">
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<div class="stars"></div>
		<div class="northern-lights"></div>
		<div class="papyrus"></div>
		<slot />
	</body>
</html>
<style is:global>
	:root {
		--nordic-gold: #C6A96D;
		--nordic-silver: #E5E6E4;
		--nordic-dark: #2A2B2E;
		--nordic-accent: #748CAB;
	}
	html {
		scroll-behavior: smooth;
		background-color: var(--nordic-dark);
		font-family: 'MedievalSharp', cursive;
	}
	body {
		margin: 0;
		padding: 0;
		color: var(--nordic-silver);
		overflow-x: hidden;
	}
	.stars {
		position: fixed;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		pointer-events: none;
		background: radial-gradient(circle at center, transparent 0%, var(--nordic-dark) 100%),
					url("data:image/svg+xml,%3Csvg width='400' height='400' viewBox='0 0 400 400' xmlns='http://www.w3.org/2000/svg'%3E%3Ccircle cx='200' cy='200' r='1' fill='%23ffffff' fill-opacity='0.3'/%3E%3C/svg%3E");
	}
	.northern-lights {
		position: fixed;
		top: 0;
		left: 0;
		width: 100%;
		height: 50%;
		background: linear-gradient(180deg, 
			rgba(116, 140, 171, 0.2) 0%,
			rgba(116, 140, 171, 0.1) 40%,
			transparent 100%);
		filter: blur(100px);
		pointer-events: none;
		animation: aurora 20s infinite;
	}
	.papyrus {
		position: fixed;
		top: 50%;
		left: 50%;
		transform: translate(-50%, -50%) rotate(-2deg);
		width: 90%;
		height: 90%;
		background: 
			linear-gradient(to right, rgba(198, 169, 109, 0.1), rgba(198, 169, 109, 0.05)),
			repeating-linear-gradient(
				to bottom,
				transparent 0px,
				transparent 2px,
				rgba(198, 169, 109, 0.03) 2px,
				rgba(198, 169, 109, 0.03) 4px
			);
		border-radius: 10px;
		box-shadow: 
			0 0 100px rgba(198, 169, 109, 0.1),
			inset 0 0 100px rgba(198, 169, 109, 0.1);
		pointer-events: none;
		opacity: 0.3;
		filter: blur(1px);
	}
	.papyrus::before {
		content: '';
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		bottom: 0;
		background: url("data:image/svg+xml,%3Csvg width='100' height='100' viewBox='0 0 100 100' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.8' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100' height='100' filter='url(%23noise)' opacity='0.08'/%3E%3C/svg%3E");
		opacity: 0.3;
		mix-blend-mode: overlay;
	}
	@keyframes aurora {
		0%, 100% { opacity: 0.5; }
		50% { opacity: 0.8; }
	}
</style>