---
---
<section id="hero" class="min-h-screen flex items-center justify-center relative px-4">
    <div class="text-center max-w-4xl mx-auto">
        <div class="mb-8">
            <svg class="w-24 h-24 mx-auto mb-4" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M12 2L3 9V20H21V9L12 2Z" stroke="var(--nordic-gold)" stroke-width="2"/>
                <path d="M12 2L9 9H15L12 2Z" stroke="var(--nordic-gold)" stroke-width="2"/>
            </svg>
        </div>
        <h1 class="text-6xl font-bold mb-4 text-nordic-gold">Serkan SAHIN</h1>
        <div class="rune-divider mb-6"></div>
        <p class="text-xl text-nordic-silver mb-8">Code Weaver of the Digital Realm</p>
        <div class="flex gap-6 justify-center">
            <a href="#about" class="nordic-btn">
                Begin Journey
            </a>
            <a href="https://github.com/yourusername" target="_blank" class="nordic-btn-outline">
                Scroll Archive
            </a>
        </div>
    </div>
</section>

<style>
    .text-nordic-gold {
        color: var(--nordic-gold);
    }
    .text-nordic-silver {
        color: var(--nordic-silver);
    }
    .rune-divider {
        height: 2px;
        background: linear-gradient(90deg, 
            transparent 0%, 
            var(--nordic-gold) 20%, 
            var(--nordic-gold) 80%, 
            transparent 100%
        );
        position: relative;
        margin: 2rem auto;
        width: 200px;
    }
    .rune-divider::before, .rune-divider::after {
        content: "❈";
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        color: var(--nordic-gold);
        font-size: 1.5rem;
    }
    .rune-divider::before {
        left: 10%;
    }
    .rune-divider::after {
        right: 10%;
    }
    .nordic-btn {
        @apply px-8 py-3 bg-[#C6A96D] text-nordic-dark font-bold rounded-sm hover:bg-[#E5E6E4] transition-colors duration-300 relative overflow-hidden;
    }
    .nordic-btn-outline {
        @apply px-8 py-3 border-2 border-[#C6A96D] text-[#C6A96D] font-bold rounded-sm hover:bg-[#C6A96D] hover:text-nordic-dark transition-colors duration-300;
    }
</style>